# 构建上下文: xingyun 后端仓库根目录
# docker build -f deploy/Dockerfile.api -t xingyun-api:local xingyun

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
# 先拷 pom 利用依赖缓存
COPY pom.xml .
COPY xingyun-api/pom.xml xingyun-api/
COPY xingyun-core/pom.xml xingyun-core/
COPY xingyun-comp/pom.xml xingyun-comp/
COPY xingyun-basedata/pom.xml xingyun-basedata/
COPY xingyun-sc/pom.xml xingyun-sc/
COPY xingyun-produce/pom.xml xingyun-produce/
COPY xingyun-settle/pom.xml xingyun-settle/
COPY xingyun-chart/pom.xml xingyun-chart/
COPY xingyun-crm/pom.xml xingyun-crm/
COPY cloud/xingyun-cloud-api/pom.xml cloud/xingyun-cloud-api/
COPY cloud/xingyun-cloud-gateway/pom.xml cloud/xingyun-cloud-gateway/
RUN --mount=type=cache,target=/root/.m2 mvn -q -B dependency:go-offline -DskipTests || true
COPY . .
RUN --mount=type=cache,target=/root/.m2 mvn -q -B -pl xingyun-api -am package -DskipTests

FROM eclipse-temurin:21-jre-jammy
WORKDIR /opt
# curl 用于 CI/CD 健康检查
RUN apt-get update -qq && apt-get install -qq -y curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /workspace/xingyun-api/target/xingyun-api.jar /opt/app.jar
EXPOSE 8080
ENV SPRING_PROFILES_ACTIVE="prod" \
    XINGYUN_TMP_DIR="/opt/data/tmp" \
    XINGYUN_UPLOAD_DIR="/opt/data/upload" \
    XINGYUN_SECURITY_UPLOAD_DIR="/opt/data/security-upload" \
    XINGYUN_LOG_DIR="/opt/logs" \
    JAVA_OPTS=""
RUN mkdir -p /opt/data/tmp /opt/data/upload /opt/data/security-upload /opt/logs
CMD ["sh", "-c", "exec java -server -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE} ${JAVA_OPTS} -jar /opt/app.jar"]
